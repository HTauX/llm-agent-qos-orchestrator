# Application
QOS_WORKFLOW_MODE=deterministic
QOS_CONFIG_PATH=./config.ini
QOS_RUNLOG_TRUNCATE=1

# MCP client
MCP_CONFIG_PATH=./mcp.json
MCP_SERVER_NAME=neo4j-cypher
MCP_READ_TOOL_NAME=read_neo4j_cypher
MCP_WRITE_TOOL_NAME=write_neo4j_cypher
MCP_EMAIL_TOOL_NAME=send_email
MCP_VERBOSE=0

# Neo4j MCP container. On macOS/Windows, use host.docker.internal.
# On Linux, the Docker bridge gateway is commonly 172.17.0.1.
NEO4J_URL=bolt://host.docker.internal:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-strong-password
NEO4J_DATABASE=neo4j
NEO4J_NAMESPACE=
NEO4J_TRANSPORT=stdio
NEO4J_READ_TIMEOUT=30
NEO4J_RESPONSE_TOKEN_LIMIT=10000
NEO4J_READ_ONLY=false
NEO4J_SCHEMA_SAMPLE_SIZE=1000

# A2A executor
EXECUTOR_HOST=127.0.0.1
EXECUTOR_PORT=8010
EXECUTOR_AGENT_CARD_URL=http://127.0.0.1:8010/.well-known/agent-card.json

# Optional LLM mode: OpenAI-compatible provider
LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Optional LLM mode: Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional email integration. Also enable it in config.ini and add email-mcp
# to MCP_SERVER_NAME before use.
EMAIL_MCP_ADDRESS=
EMAIL_MCP_PASSWORD=
EMAIL_MCP_CONFIG_PATH=./integrations/email_mcp/config.ini
EMAIL_MCP_DEBUG=0
